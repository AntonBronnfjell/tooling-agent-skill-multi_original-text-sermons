#!/usr/bin/env bash
# Repo-local pre-commit (enabled by install.sh via core.hooksPath=hooks).
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

python3 -m unittest discover -s tests
python3 scripts/lint_skill.py

DB="${OTS_DB:-data/bible.db}"
if [ -f "$DB" ]; then
  python3 scripts/check_sermon.py evals/fixtures/positive/*.md
else
  echo "pre-commit: $DB missing, skipping fixture validation (run ./install.sh)" >&2
fi
